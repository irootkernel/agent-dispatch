{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-dispatch:schema:hermes-task-request:v1",
  "title": "Agent Dispatch Hermes Task Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dispatch_id",
    "idempotency_key",
    "route",
    "resource",
    "activation",
    "acceptance_criteria"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-dispatch.hermes-task/v1"
    },
    "dispatch_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^agent-dispatch:v[12]:sha256:[0-9a-f]{64}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workspace"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "workstream"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "workstream": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "skills"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mutex_key": {
          "type": "string"
        }
      }
    },
    "execution_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "generation",
        "content_fingerprint",
        "manifest",
        "flags"
      ],
      "properties": {
        "mode": {
          "const": "latest_state"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "content_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "operation"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "enum": [
                  "create",
                  "modify",
                  "delete"
                ]
              },
              "before_digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "after_digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
