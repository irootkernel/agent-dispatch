{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:agent-dispatch:schema:sync-status-request:v1","title":"Agent Dispatch fresh status request v1","type":"object","additionalProperties":false,
  "required":["schema_version","group_id","sender","receiver","membership_revision","content_ref","target_commit","scope_digest","contract_digest","nonce"],
  "properties":{"schema_version":{"const":"agent-dispatch.sync-status-request/v1"},"group_id":{"$ref":"#/$defs/id"},"sender":{"$ref":"#/$defs/id"},"receiver":{"$ref":"#/$defs/id"},"membership_revision":{"$ref":"#/$defs/oid"},"content_ref":{"$ref":"#/$defs/ref"},"target_commit":{"$ref":"#/$defs/oid"},"scope_digest":{"$ref":"#/$defs/digest"},"contract_digest":{"$ref":"#/$defs/digest"},"nonce":{"type":"string","minLength":16,"maxLength":128}},
  "$defs":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"oid":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},"ref":{"type":"string","pattern":"^refs/heads/[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9])?$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
