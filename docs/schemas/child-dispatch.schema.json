{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-dispatch:schema:child-dispatch:v1",
  "title": "Agent Dispatch Child Dispatch v1",
  "description": "The aggregate/destination lineage and independent intent identity of one destination's dispatch beneath an aggregate event (E12-T1, DAT-010, FAN-003). The child's idempotency key is the DAT-014 destination-scoped projection; a retry preserves both the child and the key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "child_id",
    "aggregate_id",
    "dispatch_id",
    "route_id",
    "destination_id",
    "destination_revision",
    "workstream",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-dispatch.child-dispatch/v1"
    },
    "child_id": {
      "type": "string",
      "minLength": 16
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 16
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "destination_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "destination_revision": {
      "type": "string",
      "minLength": 1
    },
    "workstream": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^agent-dispatch:v2:sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
