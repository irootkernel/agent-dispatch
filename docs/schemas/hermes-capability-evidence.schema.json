{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-dispatch:schema:hermes-capability-evidence:v2",
  "title": "Agent Dispatch Hermes Capability Evidence v2",
  "description": "The cached public-interface probe record generated by `agent-dispatch hermes probe` (E11-T2, ADR-0017). The file is machine-generated and never operator-authored (HER-012); it is keyed by executable path and digest, reported version, and probe contract, and invalidated when any of them changes (HER-013).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_contract",
    "probed_at",
    "executable_path",
    "executable_sha256",
    "hermes_version",
    "shapes",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-dispatch.hermes-capability-evidence/v2"
    },
    "probe_contract": {
      "const": "agent-dispatch.hermes-probe/v2"
    },
    "probed_at": {
      "type": "string",
      "format": "date-time"
    },
    "executable_path": {
      "type": "string",
      "minLength": 1
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hermes_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "missing_create_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^--[a-z-]+$"
      }
    },
    "shapes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "assignees_json",
        "list_json",
        "create_surface",
        "skill_table"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/shape"
        },
        "assignees_json": {
          "$ref": "#/$defs/shape"
        },
        "list_json": {
          "$ref": "#/$defs/shape"
        },
        "create_surface": {
          "$ref": "#/$defs/shape"
        },
        "skill_table": {
          "$ref": "#/$defs/shape"
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^cap:[0-9a-f]{32}$"
    },
    "profile": {
      "type": "string",
      "description": "The skill-table scope the record was probed under (\"\" = unscoped); a cache read with a different scope is stale (HER-013)."
    }
  },
  "$defs": {
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ran",
        "passed"
      ],
      "properties": {
        "ran": {
          "const": true
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
