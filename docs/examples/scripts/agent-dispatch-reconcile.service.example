# E6-T3 systemd --user scheduled-reconciliation example (OPS-007).
# Install for the current user:
#   cp agent-dispatch-reconcile.service agent-dispatch-reconcile.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agent-dispatch-reconcile.timer
# Replace /usr/local/bin/agent-dispatch and wiki-maintenance with the installed
# binary path and route id. The recipe carries --submit: the two-key gate is
# the safety boundary (E9-T4/T2-F001) — before the production
# acknowledgement the route fails closed at exit 14 until `route enable
# --acknowledge-production-gate` records it, and after it a route disabled
# in configuration (the YAML key) persists its decisions and recovers
# without submitting.
[Unit]
Description=Agent Dispatch scheduled daily reconciliation (no daemon; one-shot CLI)
Documentation=file:/usr/local/share/doc/agent-dispatch/runbook.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/agent-dispatch reconcile --route wiki-maintenance --reason scheduled --submit --output json
# StateDirectory is not used: the state dir comes from the configuration
# (configuration-spec s3) and stays owned by the operator.
NoNewPrivileges=true
PrivateTmp=true
