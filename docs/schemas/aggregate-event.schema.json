{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-dispatch:schema:aggregate-event:v1",
  "title": "Agent Dispatch Aggregate Event v1",
  "description": "One normalized source/policy occurrence and its destination-selection summary (E12-T1, DAT-010, ADR-0016). The aggregate event is independently generated identity; it never substitutes for the content fingerprint and never replaces the child dispatch records beneath it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aggregate_id",
    "decision_id",
    "route_id",
    "route_revision",
    "resource_id",
    "origin",
    "generation",
    "content_fingerprint",
    "selection",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-dispatch.aggregate-event/v1"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 16
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "route_revision": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "arrival",
        "followup",
        "rerun",
        "rebuild",
        "reconcile"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "content_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "destination_id",
          "destination_revision",
          "workstream",
          "reason"
        ],
        "properties": {
          "destination_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "destination_revision": {
            "type": "string",
            "minLength": 1
          },
          "workstream": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
