{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-dispatch:schema:sync-import:v1",
  "title": "Agent Dispatch sync import v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "import_id", "plan_id", "journal_id", "group_id", "from_commit", "target_commit", "membership_revision", "acknowledgement_id", "resource_observation_revision", "expected_git_state_digest", "history_evidence_id", "case_mode", "state", "reason", "paths", "attempts", "claim_owner", "fence", "retain_until_resolved"],
  "properties": {
    "schema_version": {"const": "agent-dispatch.sync-import/v1"}, "import_id": {"$ref": "#/$defs/id"}, "plan_id": {"$ref": "#/$defs/id"}, "journal_id": {"$ref": "#/$defs/id"}, "group_id": {"$ref": "#/$defs/group"},
    "from_commit": {"$ref": "#/$defs/oid"}, "target_commit": {"$ref": "#/$defs/oid"}, "membership_revision": {"$ref": "#/$defs/oid"},
    "acknowledgement_id": {"$ref": "#/$defs/id"}, "resource_observation_revision": {"type": "integer", "minimum": 1}, "expected_git_state_digest": {"$ref": "#/$defs/digest"}, "history_evidence_id": {"$ref": "#/$defs/id"},
    "case_mode": {"enum": ["sensitive", "insensitive"]},
    "controller_only": {"type": "boolean"},
    "state": {"enum": ["requested", "fetched", "validated", "deferred", "applying", "applied", "blocked", "recovering", "uncertain"]},
    "reason": {"enum": ["none", "acknowledgement_stale", "membership_stale", "local_overlap", "untracked_collision", "git_unstable", "history_uncovered", "history_diverged", "trust_failed", "partial_effect", "bound_exhausted"]},
    "paths": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["path", "before", "after"], "properties": {"path": {"type": "string", "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+(?:/[^/\\\\\\x00-\\x1f\\x7f]+)*\\.(?:[mM][dD]|[mM][aA][rR][kK][dD][oO][wW][nN])$"}, "before": {"$ref": "#/$defs/digestOrAbsent"}, "after": {"$ref": "#/$defs/digestOrAbsent"}}}},
    "attempts": {"type": "integer", "minimum": 0, "maximum": 20}, "claim_owner": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "fence": {"type": "integer", "minimum": 1}, "retain_until_resolved": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"controller_only": {"const": true}}, "required": ["controller_only"]}, "then": {"properties": {"paths": {"maxItems": 0}}}, "else": {"properties": {"paths": {"minItems": 1}}}},
    {"if": {"properties": {"state": {"enum": ["requested", "fetched", "validated", "applying"]}}, "required": ["state"]}, "then": {"properties": {"reason": {"const": "none"}, "retain_until_resolved": {"const": true}}}},
    {"if": {"properties": {"state": {"const": "applied"}}, "required": ["state"]}, "then": {"properties": {"reason": {"const": "none"}, "retain_until_resolved": {"const": false}}}},
    {"if": {"properties": {"state": {"const": "deferred"}}, "required": ["state"]}, "then": {"properties": {"reason": {"enum": ["acknowledgement_stale", "local_overlap", "untracked_collision", "git_unstable"]}, "retain_until_resolved": {"const": true}}}},
    {"if": {"properties": {"state": {"const": "blocked"}}, "required": ["state"]}, "then": {"properties": {"reason": {"enum": ["membership_stale", "history_uncovered", "history_diverged", "trust_failed", "bound_exhausted"]}, "retain_until_resolved": {"const": true}}}},
    {"if": {"properties": {"state": {"const": "recovering"}}, "required": ["state"]}, "then": {"properties": {"reason": {"const": "partial_effect"}, "retain_until_resolved": {"const": true}}}},
    {"if": {"properties": {"state": {"const": "uncertain"}}, "required": ["state"]}, "then": {"properties": {"reason": {"const": "partial_effect"}, "retain_until_resolved": {"const": true}}}}
  ],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"}, "group": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}, "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "digestOrAbsent": {"oneOf": [{"$ref": "#/$defs/digest"}, {"const": "absent"}]}}
}
