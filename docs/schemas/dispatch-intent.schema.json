{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jjukkumi:schema:dispatch-intent:v1",
  "title": "JJUKKUMI DispatchIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch_id",
    "decision_id",
    "route",
    "target_id",
    "resource_id",
    "generation",
    "idempotency_key",
    "content_fingerprint",
    "state",
    "request",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "jjukkumi.dispatch-intent/v1"
    },
    "dispatch_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "target_id": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^jjukkumi:v1:sha256:[0-9a-f]{64}$"
    },
    "content_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "ready",
        "submitting",
        "accepted",
        "rejected",
        "unknown",
        "retry_wait",
        "reconciling",
        "dead_lettered",
        "superseded",
        "completed",
        "failed",
        "canceled"
      ]
    },
    "request": {
      "$ref": "urn:jjukkumi:schema:hermes-task-request:v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
