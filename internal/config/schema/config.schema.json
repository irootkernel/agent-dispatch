{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-dispatch:schema:config:v1",
  "title": "Agent Dispatch Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "instance",
    "resources",
    "routes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "state_dir": {
          "type": "string",
          "minLength": 1
        },
        "log_paths": {
          "enum": [
            "relative",
            "redacted",
            "full"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_stdin_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "max_path_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 65536
        },
        "max_hash_file_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "max_subprocess_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        }
      }
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    },
    "targets": {
      "type": "object",
      "description": "Webhook delivery targets. Hermes Kanban targets are declared under hermes_targets since the v0.1.5 destinations cutover; a hermes-kanban entry here is refused with a regeneration path.",
      "additionalProperties": {
        "$ref": "#/$defs/hermesWebhook"
      }
    },
    "hermes_targets": {
      "type": "object",
      "description": "Hermes Kanban delivery targets probed for compatibility against the public interface (ADR-0017). Keys name the capability-cache file and must match the destination-ID pattern.",
      "propertyNames": {
        "$ref": "#/$defs/destinationId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/hermesTarget"
      }
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/route"
      }
    },
    "retention": {
      "$ref": "#/$defs/retention"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "destinationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:/.*|keychain:.+|fd:[1-9][0-9]*)$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "root",
        "file_scope"
      ],
      "properties": {
        "type": {
          "const": "directory"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "file_scope": {
          "const": "markdown"
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "disabled",
                "optional"
              ]
            }
          }
        }
      }
    },
    "capability": {
      "enum": [
        "durable_acceptance",
        "submit_idempotency_key",
        "lookup_by_idempotency_key",
        "lookup_by_external_ref",
        "resource_mutex",
        "execution_status",
        "cancellation",
        "result_receipt"
      ]
    },
    "hermesTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "board",
        "compatibility"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "board": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Hermes kanban board slug the destinations submit to; the operator creates it with the public boards create command."
        },
        "minimum_version": {
          "$ref": "#/$defs/version",
          "default": "0.19.1",
          "description": "Eligibility floor; at least 0.19.1 with no maximum (HER-011)."
        },
        "compatibility": {
          "const": "capability_probe",
          "description": "Compatibility is proven by the public-interface capability probe (ADR-0017)."
        },
        "submit_timeout": {
          "$ref": "#/$defs/duration"
        },
        "lookup_timeout": {
          "$ref": "#/$defs/duration"
        },
        "environment_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "hermesWebhook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "endpoint",
        "auth"
      ],
      "properties": {
        "type": {
          "const": "hermes-webhook"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "secret_ref"
          ],
          "properties": {
            "type": {
              "enum": [
                "bearer",
                "header"
              ]
            },
            "header_name": {
              "type": "string",
              "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
            },
            "secret_ref": {
              "$ref": "#/$defs/secretRef"
            }
          }
        },
        "submit_timeout": {
          "$ref": "#/$defs/duration"
        },
        "idempotency_header": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "description": "Capability names the destination requires; the static webhook declaration fails closed on any it does not provide (HER-005)."
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "initial_backoff",
        "max_backoff",
        "multiplier",
        "jitter_fraction"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "initial_backoff": {
          "$ref": "#/$defs/duration"
        },
        "max_backoff": {
          "$ref": "#/$defs/duration"
        },
        "multiplier": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 10.0
        },
        "jitter_fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 0.5
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Closed structural selection classes (FAN-004): values within one key OR, present keys AND, absent keys select unconditionally (FAN-005).",
      "properties": {
        "path_include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "path_exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "create",
              "modify",
              "delete"
            ]
          }
        },
        "classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "normal",
              "protected",
              "bulk",
              "overflow",
              "malformed",
              "stale",
              "unknown"
            ]
          }
        },
        "policy_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "drop",
              "dispatch",
              "merge_pending",
              "quarantine",
              "reconcile"
            ]
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "workstream",
        "execution_hints"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/destinationId"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "Hermes profile; required and non-empty for a hermes destination, empty for a webhook destination (HER-015)."
        },
        "skills": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workstream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "workspace": {
          "type": "string",
          "pattern": "^(scratch|worktree|worktree:.+|dir:.+)$",
          "description": "Hermes workspace form; defaults to dir:<resource root> when omitted."
        },
        "serialization_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "description": "Explicit Agent Dispatch serialization group (CON-011): at most one active child per effective group in one state database. Omitted, the deprecated mutex_key alias, or the resource-derived default resource:<resource_id> resolve in that order; an explicit default-form value intentionally joins the resource-derived group. New configuration never emits mutex_key."
        },
        "mutex_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "description": "Deprecated compatibility alias of serialization_group: it may coexist with the explicit field only when the values are identical (a deprecation warning); differing values fail validation."
        },
        "execution_hints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_runtime",
            "max_attempts"
          ],
          "properties": {
            "max_runtime": {
              "$ref": "#/$defs/duration"
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sinks"
      ],
      "properties": {
        "events": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "enum": [
              "work_completed",
              "work_failed",
              "work_exhausted",
              "delivery_unknown",
              "quarantined",
              "reconciliation_required",
              "integration_drift",
              "watchman_drift"
            ]
          }
        },
        "sinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/destinationId"
              },
              "type": {
                "enum": [
                  "webhook",
                  "log"
                ]
              },
              "endpoint": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "auth": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "secret_ref"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "bearer",
                      "header"
                    ]
                  },
                  "header_name": {
                    "type": "string",
                    "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
                  },
                  "secret_ref": {
                    "$ref": "#/$defs/secretRef"
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "webhook"
                    }
                  }
                },
                "then": {
                  "required": [
                    "endpoint",
                    "auth"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "log"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "endpoint": false,
                    "auth": false
                  }
                }
              }
            ]
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "source",
        "batching",
        "policy",
        "fanout_mode",
        "destinations",
        "submission_retry",
        "latest_state",
        "failure_budget",
        "active_stale_after",
        "reconciliation"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "source_id",
            "resource",
            "trigger_name",
            "include",
            "exclude"
          ],
          "properties": {
            "type": {
              "const": "watchman-trigger"
            },
            "source_id": {
              "$ref": "#/$defs/id"
            },
            "resource": {
              "$ref": "#/$defs/id"
            },
            "trigger_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "batching": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "automatic_threshold",
            "hard_limit",
            "max_manifest_bytes"
          ],
          "properties": {
            "automatic_threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "hard_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "max_manifest_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 16777216
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protected",
            "immutable",
            "bulk_action",
            "overflow_action",
            "fresh_instance_action",
            "unsafe_path_action"
          ],
          "properties": {
            "protected": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "immutable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bulk_action": {
              "enum": [
                "quarantine",
                "reconcile"
              ]
            },
            "overflow_action": {
              "const": "reconcile"
            },
            "fresh_instance_action": {
              "const": "reconcile"
            },
            "unsafe_path_action": {
              "const": "quarantine"
            }
          }
        },
        "fanout_mode": {
          "const": "all",
          "description": "The v0.1.5 fan-out vocabulary contains only all (FAN-006)."
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/destination"
          }
        },
        "notifications": {
          "$ref": "#/$defs/notifications"
        },
        "submission_retry": {
          "$ref": "#/$defs/retry"
        },
        "latest_state": {
          "const": true
        },
        "failure_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "active_stale_after": {
          "$ref": "#/$defs/duration"
        },
        "allow_cross_group_concurrency": {
          "type": "boolean",
          "description": "Explicit acknowledgement that destinations governing this route's resource run under different serialization groups (CON-013). Required on every involved route before cross-group concurrency is permitted; the acknowledgement joins the route revision, so changing it pauses production acknowledgement."
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "daily_expected"
          ],
          "properties": {
            "initial": {
              "type": "boolean"
            },
            "daily_expected": {
              "type": "boolean"
            }
          }
        },
        "retention": {
          "$ref": "#/$defs/retention"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observations": {
          "$ref": "#/$defs/duration"
        },
        "attempts": {
          "$ref": "#/$defs/duration"
        },
        "completed_receipts": {
          "$ref": "#/$defs/duration"
        },
        "resolved_quarantine": {
          "$ref": "#/$defs/duration"
        },
        "unresolved": {
          "enum": [
            "forever"
          ]
        }
      }
    }
  }
}
