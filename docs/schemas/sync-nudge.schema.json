{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:agent-dispatch:schema:sync-nudge:v1","title":"Agent Dispatch sync nudge v1","type":"object","additionalProperties":false,
  "required":["schema_version","group_id","publication_id","sender","receiver","membership_revision","content_ref","target_commit"],
  "properties":{"schema_version":{"const":"agent-dispatch.sync-nudge/v1"},"group_id":{"$ref":"#/$defs/identity"},"publication_id":{"$ref":"#/$defs/record"},"sender":{"$ref":"#/$defs/identity"},"receiver":{"$ref":"#/$defs/identity"},"membership_revision":{"$ref":"#/$defs/oid"},"content_ref":{"$ref":"#/$defs/ref"},"target_commit":{"$ref":"#/$defs/oid"}},
  "$defs":{"identity":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"record":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,127}$"},"ref":{"type":"string","pattern":"^refs/heads/[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9])?$"},"oid":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}}
}
